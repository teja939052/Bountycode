              "buggy_code": "def rise(x):\n    return x + 20\n\nprint(rise(120))",
              "expected_output": "144",
              "actual_output": "140 (20 was added as an absolute number, not a percentage)",
              "diagnosis": {
                "question": "Which of these is the true cause?",
                "options": [
                  {
                    "id": "a",
                    "text": "20 was added as an absolute value instead of computing 20% of 120",
                    "correct": true,
                    "why": "20% of 120 is 24; 120 + 24 = 144."
                  },
                  {
                    "id": "b",
                    "text": "The function should multiply instead of add",
                    "correct": false,
                    "why": "120 * 20 is 2400, not 144."
                  },
                  {
                    "id": "c",
                    "text": "The starting value is wrong",
                    "correct": false,
                    "why": "120 is correct."
                  },
                  {
                    "id": "d",
                    "text": "print should not be inside the function",
                    "correct": false,
                    "why": "print outside is fine."
                  }
                ]
              },
              "fix": "return x + x * 20 / 100",
              "fixed_code": "def rise(x):\n    return x + x * 20 / 100\n\nprint(rise(120))",
              "explanation": "20% of 120 is 24. Adding 24 gives 144. Adding 20 treats the percent as an absolute amount."
