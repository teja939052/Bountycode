    "title": "Move Zeroes",
    "question": "Move Zeroes",
    "difficulty": "easy",
    "topic": "arrays",
    "sub_topic": "two pointers",
    "pattern": "two pointers",
    "skill": "two pointers",
    "solution": {
      "code": "def move_zeroes(nums):\n    return [x for x in nums if x != 0] + [0] * (len(nums) - sum(1 for x in nums if x != 0))\n",
