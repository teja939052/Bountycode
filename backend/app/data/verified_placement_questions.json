    "id": "verify-013",
    "type": "coding",
    "title": "Merge Intervals: merge all overlapping intervals",
    "question": "Merge Intervals: merge all overlapping intervals",
    "difficulty": "medium",
    "topic": "arrays",
    "sub_topic": "sorting",
    "pattern": "sorting",
    "skill": "sorting",
    "solution": {
      "code": "def merge_intervals(intervals):\n    if not intervals:\n        return []\n    intervals.sort()\n    res = [intervals[0][:]]\n    for s, e in intervals[1:]:\n        if s <= res[-1][1]:\n            res[-1][1] = max(res[-1][1], e)\n        else:\n            res.append([s, e])\n    return res\n",
