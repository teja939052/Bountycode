    "id": "verify-001",
    "type": "coding",
    "title": "Two Sum: find indices of two numbers that add to a target",
    "question": "Two Sum: find indices of two numbers that add to a target",
    "difficulty": "easy",
    "topic": "arrays",
    "sub_topic": "hashing",
    "pattern": "hashing",
    "skill": "hashing",
    "solution": {
      "code": "def two_sum(nums, target):\n    seen = {}\n    for i, num in enumerate(nums):\n        comp = target - num\n        if comp in seen:\n            return [seen[comp], i]\n        seen[num] = i\n    return []\n",
      "language": "python"
    },
    "testcases": [
      {
        "input": [
          [
            2,
            7,
            11,
            15
          ],
          9
        ],
