  {
    "id": "verify-002",
    "type": "coding",
    "title": "Maximum Subarray Sum",
    "question": "Maximum Subarray Sum",
    "difficulty": "medium",
    "topic": "arrays",
    "sub_topic": "dynamic programming",
    "pattern": "dynamic programming",
    "skill": "dynamic programming",
    "solution": {
      "code": "def max_subarray(nums):\n    best = cur = nums[0]\n    for x in nums[1:]:\n        cur = max(x, cur + x)\n        best = max(best, cur)\n    return best\n",
      "language": "python"
    },
