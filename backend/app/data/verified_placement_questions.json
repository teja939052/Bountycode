    "id": "verify-016",
    "type": "coding",
    "title": "Binary Search: return index of target or -1",
    "question": "Binary Search: return index of target or -1",
    "difficulty": "easy",
    "topic": "binary search",
    "sub_topic": "binary search",
    "pattern": "binary search",
    "skill": "binary search",
    "solution": {
      "code": "def binary_search(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        m = (lo + hi) // 2\n        if nums[m] == target:\n            return m\n        if nums[m] < target:\n            lo = m + 1\n        else:\n            hi = m - 1\n    return -1\n",
      "language": "python"
    },
