  {
    "id": "verify-010",
    "type": "coding",
    "title": "Group Anagrams: group words that are anagrams",
    "question": "Group Anagrams: group words that are anagrams",
    "difficulty": "medium",
    "topic": "strings",
    "sub_topic": "hashing",
    "pattern": "hashing",
    "skill": "hashing",
    "solution": {
      "code": "def group_anagrams(words):\n    groups = {}\n    for w in words:\n        key = ''.join(sorted(w))\n        groups.setdefault(key, []).append(w)\n    return [sorted(g) for g in groups.values()]\n",
      "language": "python"
    },
