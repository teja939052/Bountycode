  {
    "id": "verify-007",
    "type": "coding",
    "title": "Valid Parentheses: check if brackets are correctly paired",
    "question": "Valid Parentheses: check if brackets are correctly paired",
    "difficulty": "easy",
    "topic": "stack",
    "sub_topic": "stack",
    "pattern": "stack",
    "skill": "stack",
    "solution": {
      "code": "def valid_parentheses(s):\n    st = []\n    pairs = {')': '(', ']': '[', '}': '{'}\n    for c in s:\n        if c in '([{':\n            st.append(c)\n        elif not st or st.pop() != pairs[c]:\n            return False\n    return not st\n",
      "language": "python"
    },
