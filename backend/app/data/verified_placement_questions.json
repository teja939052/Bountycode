    "type": "coding",
    "title": "Product of Array Except Self",
    "question": "Product of Array Except Self",
    "difficulty": "medium",
    "topic": "arrays",
    "sub_topic": "prefix product",
    "pattern": "prefix product",
    "skill": "prefix product",
    "solution": {
      "code": "def product_except_self(nums):\n    n = len(nums)\n    out = [1] * n\n    left = 1\n    for i in range(n):\n        out[i] = left\n        left *= nums[i]\n    right = 1\n    for i in range(n - 1, -1, -1):\n        out[i] *= right\n        right *= nums[i]\n    return out\n",
      "language": "python"
