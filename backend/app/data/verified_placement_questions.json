    "title": "Climbing Stairs: count distinct ways to climb n steps",
    "question": "Climbing Stairs: count distinct ways to climb n steps",
    "difficulty": "easy",
    "topic": "dynamic programming",
    "sub_topic": "dynamic programming",
    "pattern": "dynamic programming",
    "skill": "dynamic programming",
    "solution": {
      "code": "def climbing_stairs(n):\n    if n <= 2:\n        return n\n    a, b = 1, 2\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b\n",
      "language": "python"
