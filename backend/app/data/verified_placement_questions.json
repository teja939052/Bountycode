  {
    "id": "verify-009",
    "type": "coding",
    "title": "Coin Change: fewest coins to make an amount",
    "question": "Coin Change: fewest coins to make an amount",
    "difficulty": "medium",
    "topic": "dynamic programming",
    "sub_topic": "dynamic programming",
    "pattern": "dynamic programming",
    "skill": "dynamic programming",
    "solution": {
      "code": "def coin_change(coins, amount):\n    dp = [amount + 1] * (amount + 1)\n    dp[0] = 0\n    for i in range(1, amount + 1):\n        for c in coins:\n            if c <= i:\n                dp[i] = min(dp[i], dp[i - c] + 1)\n    return -1 if dp[amount] > amount else dp[amount]\n",
      "language": "python"
    },
