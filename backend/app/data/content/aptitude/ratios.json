      "id": "ratio_basics",
      "title": "Ratio Basics",
      "concept": "A ratio a:b compares two quantities of the same kind. Equivalent ratios: multiply/divide both terms by the same number.",
      "formula": "a:b = a/b; a:b = (ka):(kb)",
      "worked_example": "Boys:Girls = 71:73 ratio 71:73. If total 144, boys = 71/144 × 144 = 71.",
      "mistakes": ["Inverting the ratio", "Using wrong total as base"]
    },
    {
      "id": "proportion",
      "title": "Proportion",
      "concept": "If a:b = c:d, then a×d = b×c (product of means = product of extremes).",
      "formula": "a:b :: c:d → ad = bc",
      "worked_example": "2:3 = 4:x → 2x = 12 → x = 6.",
      "mistakes": ["Cross-multiplying incorrectly", "Setting up proportion with wrong terms"]
    }
  ],
