    {"id": "percentages_meaning", "title": "Percentage Meaning", "concept": "A percentage is a number or ratio expressed as a fraction of 100. The symbol % means \"per 100.\" So x% = x/100.", "formula": "x% = x/100", "worked_example": "25% = 25/100 = 1/4 = 0.25. So 25% of a quantity is one quarter of it.", "mistakes": ["Treating 25% as 25 instead of 0.25", "Forgetting that % always relates to 100"]},
    {"id": "percentage_of_quantity", "title": "Percent of a Number", "concept": "To find x% of a number, convert the percent to a decimal/fraction and multiply.", "formula": "x% of N = (x/100) × N", "worked_example": "20% of 150 = 0.20 × 150 = 30.", "mistakes": ["Forgetting to convert % to decimal before multiplying", "Dividing instead of multiplying"]},
    {"id": "finding_percentage", "title": "What Percent?", "concept": "To find what percentage A is of B, divide A by B and multiply by 100.", "formula": "A is what % of B = (A ÷ B) × 100", "worked_example": "25 is what % of 200? (25 ÷ 200) × 100 = 12.5%.", "mistakes": ["Dividing in the wrong order (B ÷ A)", "Forgetting to multiply by 100"]},
    {"id": "percentage_increase", "title": "Percentage Increase", "concept": "An increase adds the percentage of the original to the original. The original is always the base.", "formula": "New = Original × (1 + x/100)", "worked_example": "Increase 100 by 20%: 100 × 1.20 = 120.", "mistakes": ["Using the new value as the base", "Adding x instead of x% of the original"]},
    {"id": "percentage_decrease", "title": "Percentage Decrease", "concept": "A decrease subtracts the percentage of the original from the original.", "formula": "New = Original × (1 - x/100)", "worked_example": "Decrease 200 by 25%: 200 × 0.75 = 150.", "mistakes": ["Subtracting x instead of x% of the original", "Using the decreased value as base"]},
    {"id": "successive_percentage_change", "title": "Successive Change", "concept": "Apply each change one after another to the current (not original) value. Percentages do not simply add.", "formula": "Final = Original × (1 ± x/100) × (1 ± y/100)", "worked_example": "100 increased 20% then decreased 10%: 100 × 1.2 × 0.9 = 108 (net +8%, not +10%).", "mistakes": ["Adding the percentages (20% − 10% = 10%)", "Applying both to the original value"]},
    {"id": "reverse_percentage", "title": "Reverse Percentage", "concept": "Given the final value after a change, work backwards to find the original.", "formula": "Original = Final ÷ (1 ± x/100)", "worked_example": "After a 20% increase the price is 120. Original = 120 ÷ 1.20 = 100.", "mistakes": ["Subtracting the percentage from the final value", "Using the wrong multiplier direction"]},
    {"id": "percentage_comparison", "title": "Compare Percentages", "concept": "To compare two quantities, express the difference as a percentage of the reference (base) value.", "formula": "A is what % more/less than B = (|A − B| ÷ B) × 100", "worked_example": "A=120, B=100. A is (20/100)×100 = 20% more than B.", "mistakes": ["Using A as the base instead of B", "Forgetting the base changes with \"more than/less than\""]}
