  "lessons": [
    {
      "id": "time_work_basics",
      "title": "Time and Work Basics",
      "concept": "If A can complete work in n days, A's 1 day's work = 1/n. Work = Rate × Time. Total work often treated as 1 unit.",
      "formula": "1 day's work = 1/n; Work done = rate × days",
      "worked_example": "A completes work in 50 days → 1 day's work = 1/50. 70 men in 5 days: total = 20×50=1000 man-days; done = 70×5=350; % = 350/1000 = 35%.",
      "mistakes": ["Forgetting to convert to man-days", "Comparing different workers without normalizing"]
    },
    {
      "id": "combined_work",
      "title": "Combined Work",
      "concept": "If A and B together complete in a days and B alone in b days, A alone = ab/(b−a) days. Combined rate = sum of individual rates.",
      "formula": "A alone = ab/(b−a); Combined rate = 1/a + 1/b",
      "worked_example": "A+B in 15 days, B alone in 20. A alone = (15×20)/(20−15) = 300/5 = 60 days.",
      "mistakes": ["Subtracting days instead of rates", "Using wrong formula arrangement"]
    },
    {
      "id": "work_wages",
      "title": "Work and Wages",
      "concept": "Wages are distributed in proportion to work done (1/day rate). If A:B rates are rA:rB, wages split in same ratio.",
      "formula": "Wage ratio = work rate ratio",
      "worked_example": "A:1/32, B:1/20, C:1/30, D:1/24 → ratio = 15:24:16:20. Total 75 parts.",
      "mistakes": ["Splitting equally instead of by rate", "Forgetting to normalize rates"]
    }
  ],
