      "title": "Average Basics",
      "concept": "Average = Sum of values ÷ Number of values. Weighted average accounts for different group sizes.",
      "formula": "Average = Sum / Count",
      "worked_example": "Mean monthly salary of 75 workers = 5680. Mean of 25 = 5400, of 30 = 5700. Remaining (20) = (5680×75 − 5400×25 − 5700×30)/20 = 6000.",
      "mistakes": ["Averaging averages without weights", "Using wrong count as denominator"]
    },
    {
      "id": "weighted_average",
      "title": "Weighted Average",
      "concept": "Combined average = (sum of all values) / (total count), accounting for group sizes.",
      "formula": "Combined avg = (n1×avg1 + n2×avg2)/(n1+n2)",
      "worked_example": "Boys avg 71 (count b), girls avg 73 (count g). Combined = (71b+73g)/(b+g).",
      "mistakes": ["Simple average of two group averages", "Ignoring group sizes"]
    }
