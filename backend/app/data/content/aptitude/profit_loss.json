  "lessons": [
    {
      "id": "profit_loss_basics",
      "title": "Profit and Loss Basics",
      "concept": "Profit = Selling Price − Cost Price. Loss = Cost Price − Selling Price. Profit% = (Profit ÷ Cost Price) × 100. Loss% = (Loss ÷ Cost Price) × 100.",
      "formula": "Profit% = (Profit / CP) × 100; Loss% = (Loss / CP) × 100",
      "worked_example": "Bought for ₹500, sold for ₹600. Profit = ₹100. Profit% = (100/500) × 100 = 20%.",
      "mistakes": ["Computing profit% on SP instead of CP", "Forgetting CP is the base"]
    },
    {
      "id": "selling_price_cost_price",
      "title": "SP and CP Formulas",
      "concept": "SP = CP × (1 + Profit%/100) when profit; SP = CP × (1 − Loss%/100) when loss. CP = SP × 100/(100+Profit%) or SP × 100/(100−Loss%).",
      "formula": "SP = CP(1 ± p/100); CP = SP × 100/(100 ± p)",
      "worked_example": "Sold for ₹840 at 20% profit. CP = 840/1.20 = ₹700.",
      "mistakes": ["Using wrong sign in denominator", "Confusing profit and loss formulas"]
    },
    {
      "id": "discount",
      "title": "Discount",
      "concept": "Discount = Marked Price − Selling Price. Discount% = (Discount ÷ Marked Price) × 100. SP = MP × (1 − Discount%/100).",
      "formula": "SP = MP × (1 − d/100); Discount% = (Discount/MP) × 100",
      "worked_example": "MP=1000, 20% discount → SP = 1000 × 0.8 = 800.",
      "mistakes": ["Applying discount to CP instead of MP", "Adding discount instead of subtracting"]
    },
    {
      "id": "successive_discount",
      "title": "Successive Discount",
      "concept": "Successive discounts compound: SP = MP × (1 − d1/100) × (1 − d2/100). They do not simply add.",
      "formula": "SP = MP(1−d1/100)(1−d2/100)",
      "worked_example": "MP=1000, discounts 10%+10% → SP = 1000×0.9×0.9 = 810. Equivalent single discount = 19%, not 20%.",
      "mistakes": ["Adding successive discounts", "Applying both to MP"]
    }
  ],
