        },
        "conditionals": {
          "if": "IF @score >= 50 BEGIN\n    PRINT 'Pass'\nEND",
          "else": "IF @score >= 50 BEGIN\n    PRINT 'Pass'\nEND ELSE BEGIN\n    PRINT 'Fail'\nEND",
          "elif": "IF @score >= 90 BEGIN\n    SET @grade = 'A'\nEND ELSE IF @score >= 75 BEGIN\n    SET @grade = 'B'\nEND ELSE BEGIN\n    SET @grade = 'C'\nEND"
        },
        "loops": {
          "for": "WHILE @i < 5 BEGIN\n    PRINT @i\n    SET @i = @i + 1\nEND",
          "while": "WHILE @count < 5 BEGIN\n    PRINT @count\n    SET @count = @count + 1\nEND",
          "break": "WHILE @i < 10 BEGIN\n    IF @i = 5 BREAK\n    SET @i = @i + 1\nEND"
        },
        "functions": {
          "define": "CREATE FUNCTION add(@a INT, @b INT)\nRETURNS INT\nBEGIN\n    RETURN @a + @b;\nEND",
          "call": "SELECT dbo.add(3, 5) AS result;",
          "no_return": "CREATE PROCEDURE greet(@name VARCHAR(50))\nAS\nBEGIN\n    PRINT 'Hello ' + @name\nEND"
        },
        "lists": {
          "create": "SELECT 'apple' AS fruit UNION ALL\nSELECT 'banana' UNION ALL\nSELECT 'orange';",
          "index": "SELECT fruit FROM fruits WHERE id = 1;",
          "append": "INSERT INTO fruits (name) VALUES ('grape');",
          "iterate": "DECLARE @fruit VARCHAR(50)\nDECLARE fruit_cursor CURSOR FOR\n    SELECT name FROM fruits\nOPEN fruit_cursor\nFETCH NEXT FROM fruit_cursor INTO @fruit\nWHILE @@FETCH_STATUS = 0\nBEGIN\n    PRINT @fruit\n    FETCH NEXT FROM fruit_cursor INTO @fruit\nEND"
        },
        "strings": {
          "create": "DECLARE @name VARCHAR(50) = 'Alice';",
          "concat": "SET @greeting = 'Hello ' + @name;",
          "format": "SET @message = FORMATMESSAGE('Hello %s', @name);",
          "slice": "SET @firstChar = SUBSTRING(@name, 1, 1);"
        },
        "dictionaries": {
          "create": "CREATE TABLE student (\n    name VARCHAR(50),\n    age INT\n);\nINSERT INTO student VALUES ('Alice', 25);",
          "access": "SELECT name FROM student WHERE age = 25;",
          "update": "UPDATE student SET age = 26 WHERE name = 'Alice';",
          "keys": "SELECT COLUMN_NAME\nFROM INFORMATION_SCHEMA.COLUMNS\nWHERE TABLE_NAME = 'student';"
        }
