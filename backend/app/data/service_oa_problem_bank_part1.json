{"id":"service_oa_problem_bank_v1_part1","parent":"service_oa_problem_bank_v1","part":1,"count":21,"problems":[{"id":"na_pct_001","section":"numerical_ability","topic":"percentages","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"A number is increased by 20% and then decreased by 20%. The net change is:","options":["No change","4% decrease","4% increase","20% decrease"],"correct_index":1,"explanation":"1.2 × 0.8 = 0.96 → 4% decrease. Successive % changes multiply, they do not cancel.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_pct_002","section":"numerical_ability","topic":"percentages","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"If 30% of a number is 90, the number is:","options":["270","300","320","350"],"correct_index":1,"explanation":"N = 90 × 100/30 = 300.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_pl_001","section":"numerical_ability","topic":"profit_loss","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"CP = ₹800, SP = ₹920. Profit percentage is:","options":["12%","15%","18%","20%"],"correct_index":1,"explanation":"Profit 120; 120/800 × 100 = 15%.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_pl_002","section":"numerical_ability","topic":"profit_loss","companies":["tcs","infosys","wipro"],"difficulty":"medium","prompt":"An item marked at ₹2,000 is sold after successive discounts of 10% and 20%. Final SP is:","options":["₹1,400","₹1,440","₹1,460","₹1,500"],"correct_index":1,"explanation":"2000 × 0.9 × 0.8 = 1440.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_tw_001","section":"numerical_ability","topic":"time_work","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"A finishes a job in 12 days, B in 18 days. Together they finish in:","options":["6 days","7.2 days","9 days","15 days"],"correct_index":1,"explanation":"1/12+1/18=5/36 → 36/5 = 7.2 days.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_tsd_001","section":"numerical_ability","topic":"time_distance","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"Equal distances at 60 km/h and 40 km/h. Average speed is:","options":["50 km/h","48 km/h","45 km/h","52 km/h"],"correct_index":1,"explanation":"Harmonic mean: 2×60×40/(60+40) = 48.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_ratio_001","section":"numerical_ability","topic":"ratio_proportion","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"If a:b = 2:3 and b:c = 4:5, then a:c is:","options":["2:5","8:15","8:12","6:15"],"correct_index":1,"explanation":"a:b=2:3=8:12; b:c=4:5=12:15 → a:c=8:15.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_avg_001","section":"numerical_ability","topic":"averages","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"Average of 12, 18, 24, 30 is:","options":["18","21","24","20"],"correct_index":1,"explanation":"(12+18+24+30)/4 = 21.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_hcf_001","section":"numerical_ability","topic":"hcf_lcm","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"HCF of 36 and 60 is:","options":["6","12","18","24"],"correct_index":1,"explanation":"Common factors; greatest is 12.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_si_001","section":"numerical_ability","topic":"simple_compound_interest","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"SI on ₹5,000 at 8% p.a. for 2 years is:","options":["₹400","₹800","₹840","₹900"],"correct_index":1,"explanation":"PRT/100 = 5000×8×2/100 = 800.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_ci_001","section":"numerical_ability","topic":"simple_compound_interest","companies":["tcs","infosys"],"difficulty":"medium","prompt":"CI on ₹1,000 at 10% p.a. for 2 years (annual) is:","options":["₹200","₹210","₹220","₹100"],"correct_index":1,"explanation":"Amount 1210; CI = 210.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_prob_001","section":"numerical_ability","topic":"probability_basics","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"P(even number) on a fair die is:","options":["1/6","1/3","1/2","2/3"],"correct_index":2,"explanation":"2,4,6 → 3/6 = 1/2.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_pipe_001","section":"numerical_ability","topic":"pipes_cisterns","companies":["tcs","wipro","infosys"],"difficulty":"medium","prompt":"A fills in 4h, B empties in 6h. Net fill rate when both open:","options":["1/4","1/6","1/12","1/3"],"correct_index":2,"explanation":"1/4 − 1/6 = 1/12 tank per hour.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"na_mix_001","section":"numerical_ability","topic":"mixture_alligation","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"Mix solutions of 20% and 50% to get 30%. Ratio of 20% to 50% solution:","options":["2:1","1:2","3:1","1:1"],"correct_index":0,"explanation":"Gaps 10 and 20 → ratio 2:1.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_ser_001","section":"reasoning_ability","topic":"number_series","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"2, 5, 8, 11, ?","options":["12","13","14","15"],"correct_index":2,"explanation":"Add 3 each time → 14.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_ser_002","section":"reasoning_ability","topic":"number_series","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"3, 7, 13, 21, 31, ?","options":["41","43","45","39"],"correct_index":1,"explanation":"Differences +4,+6,+8,+10,+12 → 31+12=43.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_cd_001","section":"reasoning_ability","topic":"coding_decoding","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"If MANGO is coded as NBOHP, ERASER is coded as:","options":["FSBTFS","FQBTFS","FSATFS","DSBTFS"],"correct_index":0,"explanation":"Each letter +1 → FSBTFS.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_br_001","section":"reasoning_ability","topic":"blood_relations","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"A is B's brother. C is A's mother. D is C's father. How is B related to D?","options":["Grandchild","Son","Uncle","Brother"],"correct_index":0,"explanation":"D is parent of C; C is parent of A and B → B is grandchild of D.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_dir_001","section":"reasoning_ability","topic":"direction_sense","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"easy","prompt":"A walks 5 km north, then 5 km east, then 5 km south. Distance from start:","options":["0 km","5 km east","10 km","5 km north"],"correct_index":1,"explanation":"Ends 5 km east of start.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_syl_001","section":"reasoning_ability","topic":"syllogisms","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"All pens are books. Some books are tables. Conclusions: I. Some pens are tables. II. Some books are pens.","options":["Only I","Only II","Both","Neither"],"correct_index":1,"explanation":"II follows from 'all pens are books'. I does not necessarily follow.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"},{"id":"lr_seat_001","section":"reasoning_ability","topic":"seating_arrangement","companies":["tcs","infosys","wipro","cognizant","accenture"],"difficulty":"medium","prompt":"Five seats in a row facing north. B at left end. A is second to the right of B. Who is in the middle if only this is known?","options":["A","B","Cannot be determined","Empty"],"correct_index":2,"explanation":"B _ A _ _ — middle still unknown.","time_sec_target":75,"tags":[],"source_style":"service_oa_original"}]}