    {"step_number": 1, "step_type": "explain", "title": "Simple interest", "content": "SI = (P × R × T) / 100. Interest is earned only on the original principal for the whole time.", "formula": "SI = PRT/100", "tip": "P = principal, R = rate % per year, T = time in years."},
    {"step_number": 2, "step_type": "interactive", "title": "Compute SI", "prompt": "SI on ₹1000 at 10% for 2 years?", "options": ["₹100", "₹200", "₹210", "₹220"], "correct_index": 1, "explanation": "SI = 1000×10×2/100 = 200.", "hints": ["Use PRT/100.", "Substitute carefully."]},
    {"step_number": 3, "step_type": "explain", "title": "Compound interest idea", "content": "CI earns interest on principal plus previously accrued interest. For 2 years at rate R: Amount = P(1+R/100)^2, CI = Amount − P."},
    {"step_number": 4, "step_type": "practice", "title": "Two-year CI", "prompt": "Approx CI on ₹1000 at 10% for 2 years (annual compounding)?", "options": ["₹200", "₹210", "₹220", "₹100"], "correct_index": 1, "explanation": "Amount = 1000×1.1×1.1 = 1210; CI = 210.", "hints": ["Multiply by 1.1 twice.", "Subtract principal."]},
    {"step_number": 5, "step_type": "practice", "title": "SI vs CI", "prompt": "For the same P, R, T>1, generally:", "options": ["SI > CI", "CI > SI", "Always equal", "CI is zero"], "correct_index": 1, "explanation": "Compounding grows the base, so CI exceeds SI for T>1 at positive rates.", "hints": ["Does interest earn interest?"]}
  ],
  "assessment": {"mastery_threshold": 0.7, "duration_sec": 300, "questions": [
