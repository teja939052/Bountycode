    {"step_number": 3, "step_type": "practice", "title": "Loop trace", "prompt": "s ← 0; for i ← 1 to 3: s ← s + i; print s. Output?", "options": ["3", "6", "9", "1"], "correct_index": 1, "explanation": "1+2+3=6.", "hints": ["Accumulate each i."]},
    {"step_number": 4, "step_type": "practice", "title": "Condition", "prompt": "n ← 4; if n mod 2 = 0 then print EVEN else print ODD.", "options": ["EVEN", "ODD", "4", "Error"], "correct_index": 0, "explanation": "4 is even.", "hints": ["mod 2 = 0 means even."]},
    {"step_number": 5, "step_type": "predict_output", "title": "Nested update", "prompt": "a ← 1; b ← 2; a ← a + b; b ← a + b; What is b?", "expected_answer": "5", "answer_placeholder": "number", "explanation": "a becomes 3; b becomes 3+2=5.", "hints": ["Update a first, then use new a for b."]}
