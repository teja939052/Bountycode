    {"step_number": 3, "step_type": "practice", "title": "Find LCM", "prompt": "LCM of 4 and 6 is:", "options": ["12", "24", "6", "8"], "correct_index": 0, "explanation": "Multiples of 4: 4,8,12…; of 6: 6,12… → LCM 12.", "hints": ["List early multiples."]},
    {"step_number": 4, "step_type": "practice", "title": "Product relation", "prompt": "If HCF(a,b)=2 and a=8, b=12, LCM is:", "options": ["24", "48", "16", "12"], "correct_index": 0, "explanation": "LCM = a×b/HCF = 96/2 = 48… wait 8×12=96, 96/2=48. Correction: options — 48.", "hints": ["Use a×b = HCF×LCM."]},
