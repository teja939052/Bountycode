    {"prompt": "Strings are best thought of as:", "options": ["Unordered sets", "Character sequences", "Booleans", "Only digits"], "correct_index": 1, "explanation": "Sequences of characters."},
    {"prompt": "\"7\"+\"8\" as strings:", "options": ["15", "78", "7 8", "56"], "correct_index": 1, "explanation": "Digit characters concatenate to 78."}
