    {"step_number": 1, "step_type": "explain", "title": "Text as sequences", "content": "A string is a sequence of characters. You can read by index and measure length, similar to arrays."},
    {"step_number": 2, "step_type": "interactive", "title": "Character at index", "prompt": "s = \"code\". s[0] is:", "options": ["c", "o", "e", "code"], "correct_index": 0, "explanation": "Index 0 is 'c'.", "hints": ["Zero-based indexing."]},
    {"step_number": 3, "step_type": "explain", "title": "Concatenation", "content": "Joining strings with + glues them end to end: \"a\"+\"b\" = \"ab\"."},
    {"step_number": 4, "step_type": "practice", "title": "Length", "prompt": "len(\"hi!\") is:", "options": ["2", "3", "4", "1"], "correct_index": 1, "explanation": "h, i, ! → 3 characters.", "hints": ["Count each character including punctuation."]},
    {"step_number": 5, "step_type": "practice", "title": "Compare carefully", "prompt": "\"10\" < \"2\" as strings may be true because:", "options": ["Numbers compare by value always", "Lexicographic digit character order", "Strings cannot compare", "10 is smaller"], "correct_index": 1, "explanation": "String compare uses character order, not integer magnitude.", "hints": ["Are these numbers or text?"]}
  ],
  "assessment": {"mastery_threshold": 0.7, "duration_sec": 300, "questions": [
