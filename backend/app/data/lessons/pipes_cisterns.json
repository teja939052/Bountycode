    {"step_number": 3, "step_type": "practice", "title": "Two inlets", "prompt": "Pipes A and B fill in 3h and 6h. Together time?", "options": ["1h", "2h", "3h", "4.5h"], "correct_index": 1, "explanation": "Rates 1/3+1/6=1/2 → 2 hours.", "hints": ["Add rates.", "Time = 1 / combined rate."]},
    {"step_number": 4, "step_type": "practice", "title": "Inlet and outlet", "prompt": "A fills in 4h, B empties in 6h. Net rate when both open?", "options": ["1/4", "1/6", "1/12", "1/3"], "correct_index": 2, "explanation": "1/4 − 1/6 = 1/12 tank per hour.", "hints": ["Subtract outlet rate."]},
