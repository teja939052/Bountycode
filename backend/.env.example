# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net
DATABASE_NAME=placementpro

# JWT Auth
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# OpenRouter AI (get key from https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Code execution (Piston API) — free key from the Piston Discord server,
# or self-host Piston via Docker and point PISTON_API_URL at it.
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=your-piston-api-key

# Local sandboxed fallback — when Piston is rate-limited/down, executes Python/JS
# in a restricted subprocess (no network, safe modules only). Set to true to enable.
USE_LOCAL_SANDBOX=false
# Max seconds a single local sandbox run may take (1-30, default 5).
SANDBOX_TIMEOUT=5

# Free remote fallbacks — tried after Piston and before the local sandbox.
# Wandbox (https://wandbox.org) + Glot.io (https://glot.io) are anonymous JSON APIs,
# best-effort with per-IP rate limits (not a security boundary). Set to true to enable.
USE_REMOTE_FALLBACKS=false
# Max seconds a single remote fallback run may take (clamped 1-15, default 8).
REMOTE_FALLBACK_TIMEOUT=8
# Optional free Glot.io API token (from your Glot.io account). Anonymous calls work too.
GLOT_API_TOKEN=

# PayPal (get keys from https://developer.paypal.com)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Google OAuth (get keys from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Free tier limits
FREE_TIER_INTERVIEW_LIMIT=3
FREE_TIER_RESUME_LIMIT=3

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
