# PlacementPro Environment Configuration
# Copy this file to .env and update values

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=placementpro

# JWT Security (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_DAYS=7

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional - for distributed caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@placementpro.app

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Free Tier Limits
FREE_TIER_INTERVIEW_LIMIT=3
FREE_TIER_RESUME_LIMIT=3
FREE_TIER_APTITUDE_LIMIT=5
FREE_TIER_COVER_LETTER_LIMIT=3
FREE_TIER_CODING_LIMIT=5
