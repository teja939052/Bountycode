{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  // Project-level: allow every tool without confirmation prompts (read, edit,
  // bash, glob, grep, list, task/subagent, external_directory, todowrite,
  // question, webfetch, websearch, lsp, doom_loop, skill, notebooks, ...).
  // Mirrors the global ~/.config/kilo/kilo.jsonc so nothing prompts either way.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "notebook_read": "allow",
    "notebook_edit": "allow",
    "notebook_execute": "allow",
    // Forward-compatible: extra tool keys Kilo may add, kept allowed too.
    "write": "allow",
    "patch": "allow",
    "codesearch": "allow",
    "mcp": "allow"
  }
}
