{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  // Allow every tool without confirmation prompts (read, edit, bash,
  // external_directory, webfetch, websearch, task/subagent, skill, lsp, ...).
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "notebook_read": "allow",
    "notebook_edit": "allow",
    "notebook_execute": "allow"
  }
}
