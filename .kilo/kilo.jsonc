{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  // Project-level: every tool auto-approves, nothing prompts.
  // Kilo 7.x runs on the OpenCode V1 permission shape, so this is the V1
  // `permission` map (the newer V2 `permissions` ruleset is rejected here).
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "notebook_read": "allow",
    "notebook_edit": "allow",
    "notebook_execute": "allow",
    // Forward-compatible: extra tool keys Kilo may add, kept allowed too.
    "write": "allow",
    "patch": "allow",
    "codesearch": "allow",
    "mcp": "allow",
    // Catch-all for any key not listed above.
    "*": "allow"
  }
}
